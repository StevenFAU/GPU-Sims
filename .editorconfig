# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# C/C++
[*.{c,cc,cpp,cxx,h,hpp,hxx}]
indent_size = 4

# Shaders
[*.{glsl,vert,frag,comp,wgsl,hlsl}]
indent_size = 4

# Python
[*.py]
indent_size = 4

# TypeScript / JavaScript
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

# Web / config
[*.{json,yml,yaml,toml,html,css,scss}]
indent_size = 2

# Markdown — preserve trailing whitespace (line breaks are meaningful)
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Makefiles use tabs
[Makefile]
indent_style = tab

# CMake
[{CMakeLists.txt,*.cmake}]
indent_size = 2
