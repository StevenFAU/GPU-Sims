# ============================================================
# Simulation outputs (large binary artifacts)
# ============================================================
# Cached simulation state and exports — these can be huge.
# Track only via Git LFS if at all; usually just regenerate.
outputs/
renders/
captures/
*.vdb
*.abc
*.usd
*.usda
*.usdc
*.usdz
# Allow tracking specific sample/reference VDB/ABC files by
# overriding in the relevant sim's .gitignore if needed.

# Image and video outputs in the repo root
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.mp4
/*.mov
/*.webm

# But preserve gallery assets in expected locations
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.gif
!**/gallery/**

# ============================================================
# Blender autosaves and locks
# ============================================================
*.blend1
*.blend2
*.blend@
.~lock.*

# ============================================================
